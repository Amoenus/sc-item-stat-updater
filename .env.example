# Copy this file to .env.local and fill in the values for your machine.
# .env.local is gitignored — never commit it.
#
# Path to your Star Citizen LIVE installation directory
# (the folder that contains Data.p4k).
# Only needed when the repo is NOT cloned inside the game tree.
#
# SC_LIVE_DIR accepts both Windows and Unix/WSL paths — use whichever
# is more convenient; the tool normalises it at runtime:
#
#   Windows path (works on both native Windows AND WSL):
#   SC_LIVE_DIR=C:/games/Roberts Space Industries/StarCitizen/LIVE
#
#   WSL/Unix path (WSL only):
#   SC_LIVE_DIR=/mnt/c/games/Roberts Space Industries/StarCitizen/LIVE
#
# Tip: forward slashes work fine on Windows, so the C:/… form is portable.

SC_LIVE_DIR=C:/games/Roberts Space Industries/StarCitizen/LIVE

# Optional: override the detected game version when local game metadata is stale.
# Use the SCMDB/DataCore folder format: <version>-live.<build> or <version>-ptu.<build>.
# SC_GAME_VERSION=4.8.2-live.12061511
