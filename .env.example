# Copy this file to .env.local and fill in the values for your machine.
# .env.local is gitignored — never commit it.
#
# Path to your Star Citizen LIVE installation directory
# (the folder that contains Data.p4k).
# Only needed when the repo is NOT cloned inside the game tree.
#
# Windows path via WSL example:
# SC_LIVE_DIR=/mnt/c/games/Roberts Space Industries/StarCitizen/LIVE
#
# Native Windows path (not recommended in WSL — use the /mnt/c/... form):
# SC_LIVE_DIR=C:\games\Roberts Space Industries\StarCitizen\LIVE

SC_LIVE_DIR=/mnt/c/games/Roberts Space Industries/StarCitizen/LIVE
