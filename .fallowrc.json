{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/index.{ts,tsx,js,jsx}",
    "src/main.{ts,tsx,js,jsx}"
  ],
  "duplicates": {
    // Hide pair-only clones; focus on widespread copy-paste
    // worth refactoring. Lower to 2 to report every duplicate pair.
    "minOccurrences": 3
    // Common additions (uncomment to enable):
    // "ignore": [
    //   "**/lib/**",          // for repos that publish transpiled output to lib/
    //   "**/legacy/**",       // for repos with legacy-build artifacts
    //   "**/__generated__/**", // Relay, GraphQL Code Generator
    //   "**/generated/**"     // OpenAPI, Protobuf codegen
    // ]
  },
  "rules": {},
  "ignoreExports": [
    {
      "file": "src/schema/scmdb/crafting-blueprints/index.ts",
      "exports": ["*"]
    },
    {
      "file": "src/schema/scmdb/crafting-items/index.ts",
      "exports": ["*"]
    },
    {
      "file": "src/items/datacore/bombs.ts",
      "exports": ["*"]
    },
    {
      "file": "src/items/datacore/coolers.ts",
      "exports": ["*"]
    },
    {
      "file": "src/items/datacore/emps.ts",
      "exports": ["*"]
    },
    {
      "file": "src/items/datacore/jump-drives.ts",
      "exports": ["*"]
    },
    {
      "file": "src/items/datacore/mining-lasers.ts",
      "exports": ["*"]
    },
    {
      "file": "src/items/datacore/mining-modifiers.ts",
      "exports": ["*"]
    },
    {
      "file": "src/items/datacore/missile-launchers.ts",
      "exports": ["*"]
    },
    {
      "file": "src/items/datacore/missiles.ts",
      "exports": ["*"]
    },
    {
      "file": "src/items/datacore/powerplants.ts",
      "exports": ["*"]
    },
    {
      "file": "src/items/datacore/qeds.ts",
      "exports": ["*"]
    },
    {
      "file": "src/items/datacore/quantum-drives.ts",
      "exports": ["*"]
    },
    {
      "file": "src/items/datacore/radars.ts",
      "exports": ["*"]
