{
  "name": "sc-item-stat-updater",
  "version": "1.0.0",
  "description": "Updates item descriptions in global.ini with detailed component stats from CSV data files.",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "update": "node --env-file-if-exists .env.local --import tsx/esm bin/update-all.ts",
    "extract": "node --env-file-if-exists .env.local --import tsx/esm bin/extract-global-ini.ts",
    "pipeline": "node --env-file-if-exists .env.local --import tsx/esm bin/pipeline.ts",
    "pipeline:scrape": "node --env-file-if-exists .env.local --import tsx/esm bin/pipeline.ts --scrape",
    "pipeline:scrape:datacore": "node --env-file-if-exists .env.local --import tsx/esm bin/pipeline.ts --datacore",
    "scrape:scmdb": "node --env-file-if-exists .env.local --import tsx/esm bin/scrape-scmdb.ts",
    "scrape:spviewer": "node --env-file-if-exists .env.local --import tsx/esm bin/scrape-spviewer.ts --all",
    "scrape:datacore": "node --env-file-if-exists .env.local --import tsx/esm bin/scrape-datacore.ts --all",
    "regen:mining-locations": "node --env-file-if-exists .env.local --import tsx/esm bin/regen-mining-locations.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "check:ci": "biome ci .",
    "test": "node --import tsx/esm --test 'src/**/*.test.ts'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amoenus/sc-item-stat-updater.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bugs": {
    "url": "https://github.com/Amoenus/sc-item-stat-updater/issues"
  },
  "homepage": "https://github.com/Amoenus/sc-item-stat-updater#readme",
  "volta": {
    "node": "24.16.0"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "@opentelemetry/api-logs": "^0.218.0",
    "@opentelemetry/core": "2.7.1",
    "@opentelemetry/sdk-logs": "^0.218.0",
    "cheerio": "^1.2.0",
    "cli-progress": "^3.12.0",
    "csv-parse": "^6.2.1",
    "csv-stringify": "^6.7.0",
    "domhandler": "^6.0.0",
    "puppeteer": "^25.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^25.8.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
